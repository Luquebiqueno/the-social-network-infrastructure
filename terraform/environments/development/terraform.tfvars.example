aws_region = "us-east-1"
owner      = "your-name"

vpc_cidr = "10.10.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.10.1.0/24",
  "10.10.2.0/24"
]

private_subnet_cidrs = [
  "10.10.11.0/24",
  "10.10.12.0/24"
]

instance_type   = "t3.small"
root_volume_size = 20

ecr_repository_names = [
  "backend",
  "frontend"
]

db_name             = "the_social_network"
db_master_username  = "tsn_admin"
db_engine_version   = "16.4"
db_instance_class   = "db.t3.micro"
db_allocated_storage = 20

# Optional. Do not commit a real email address in terraform.tfvars.
# alert_email = "alerts@example.com"
